{
  "name": "@jbb/api",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "wrangler dev src/index.ts --port 8787",
    "deploy": "wrangler deploy src/index.ts",
    "db:migrate:local": "wrangler d1 execute jbb-prod-db --local --file=../../packages/database/drizzle/migrations/0000_chief_nitro.sql",
    "db:seed:local": "wrangler d1 execute jbb-prod-db --local --file=../../packages/database/drizzle/seed.sql",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit"
  },
  "dependencies": {
    "@hono/zod-validator": "^0.9.1",
    "@jbb/database": "workspace:*",
    "@jbb/types": "workspace:*",
    "@jbb/validators": "workspace:*",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.13.5",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260831.1",
    "typescript": "^5.8.2",
    "wrangler": "^4.127.1"
  }
}
